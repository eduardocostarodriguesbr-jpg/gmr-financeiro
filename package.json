{
  "name": "gmr-financeiro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"wrangler dev --port 8787\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "master:provision": "node scripts/provision-master.mjs",
    "test": "node --test scripts/money.test.mjs scripts/page-contracts.test.mjs && node scripts/integration.mjs",
    "check": "tsc --noEmit",
    "preview": "wrangler dev --port 8787",
    "test:navigation": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
